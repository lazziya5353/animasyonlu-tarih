 "duration": 104.75,
 "jumps": [],
 "captions": [
  {
   "start": 0.0,
   "end": 3.98,
   "text": "Dünyanın en eski kitapları, cennetten dört nehir aktığını yazar."
  },
  {
   "start": 4.32,
   "end": 6.52,
   "text": "Bunlardan ikisi bugün Türkiye'den doğuyor."
  },
  {
   "start": 6.94,
   "end": 11.54,
   "text": "Tevrat'ta Aden bahçesinden çıkan nehirlerin ikisinin adı: Hiddekel ve Perat."
  },
  {
   "start": 11.92,
   "end": 13.12,
   "text": "Yani Dicle ve Fırat."
  },
  {
   "start": 13.54,
   "end": 17.13,
   "text": "Fırat iki koldan doğar: Erzurum'da Dumlu Dağı'ndan çıkan Karasu,"
  },
  {
   "start": 17.16,
   "end": 18.9,
   "text": "ve Ağrı'dan gelen Murat."
  },
  {
   "start": 19.26,
   "end": 21.14,
   "text": "İki kol Elazığ'da, Keban'da birleşir."
  },
  {
   "start": 21.5,
   "end": 23.73,
   "text": "O birleşme noktası bugün baraj gölünün altında."
  },
  {
   "start": 23.76,
   "end": 28.26,
   "text": "Dicle'nin kaynağı hemen yanında: Elazığ'daki Hazar Gölü ve Hazarbaba Dağı."
  },
  {
   "start": 28.56,
   "end": 32.5,
   "text": "Fırat yaklaşık 2.800 kilometre akar, Dicle ise 1.900."
  },
  {
   "start": 32.92,
   "end": 34.74,
   "text": "İkisi de Suriye ve Irak'tan geçer."
  },
  {
   "start": 35.08,
   "end": 38.9,
   "text": "Aradaki topraklara Yunanlılar 'iki nehir arası' dedi: Mezopotamya."
  },
  {
   "start": 39.26,
   "end": 41.22,
   "text": "Yazının ve ilk şehirlerin doğduğu yer."
  },
  {
   "start": 41.6,
   "end": 44.46,
   "text": "Ama asıl ilginç olan, bu iki nehrin buluştuğu yer."
  },
  {
   "start": 44.8,
   "end": 47.82,
   "text": "Irak'ın güneyinde, Kurna'da birleşip Şattülarap olurlar,"
  },
  {
   "start": 48.16,
   "end": 51.11,
   "text": "ve yaklaşık 200 kilometre sonra Basra Körfezi'ne dökülürler."
  },
  {
   "start": 51.14,
   "end": 54.3,
   "text": "Rivayete göre Kurna'da Hz. Âdem'in ağacı varmış."
  },
  {
   "start": 54.66,
   "end": 57.0,
   "text": "Bazıları Aden bahçesinin burada olduğuna inanır."
  },
  {
   "start": 57.32,
   "end": 58.94,
   "text": "Peki bu nehirler ne kadar derin?"
  },
  {
   "start": 59.34,
   "end": 61.78,
   "text": "Doğal yataklarında çoğu yerde sadece birkaç metre."
  },
  {
   "start": 62.2,
   "end": 66.42,
   "text": "Ama barajlar her şeyi değiştirdi. Atatürk Barajı'nın gövdesi 169 metre."
  },
  {
   "start": 66.88,
   "end": 68.9,
   "text": "Gölü, Türkiye'nin üçüncü büyük gölü."
  },
  {
   "start": 69.08,
   "end": 73.12,
   "text": "Dicle'deki Ilısu Barajı ise binlerce yıllık Hasankeyf'i suların altına aldı."
  },
  {
   "start": 73.48,
   "end": 76.12,
   "text": "Bir de Fırat'ın en gizemli tarafı var: altın."
  },
  {
   "start": 76.46,
   "end": 82.66,
   "text": "Peygamber Efendimiz (s.a.v.) bir hadisinde, kıyamete yakın Fırat'ın altından bir hazine çıkaracağını bildirir."
  },
  {
   "start": 82.96,
   "end": 84.56,
   "text": "İnsanlar onun için savaşacak."
  },
  {
   "start": 84.96,
   "end": 87.02,
   "text": "Aynı hadiste Peygamber Efendimiz şöyle uyarır:"
  },
  {
   "start": 87.38,
   "end": 89.62,
   "text": "Kim orada bulunursa, ondan bir şey almasın."
  },
  {
   "start": 90.04,
   "end": 94.16,
   "text": "Bazıları bunu nehrin kurumasıyla, bazıları petrol ya da su kaynaklarıyla yorumlar."
  },
  {
   "start": 94.54,
   "end": 95.38,
   "text": "Kesin bir yorum yok."
  },
  {
   "start": 95.84,
   "end": 99.18,
   "text": "Cennetten aktığına inanılan iki nehir, binlerce yıldır hayat taşıyor."
  },
  {
   "start": 99.6,
   "end": 101.72,
   "text": "Sence Aden bahçesi gerçekten orada mıydı?"
  }
 ]
}