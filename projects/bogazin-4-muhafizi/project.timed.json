  {
   "start": 0.27,
   "end": 6.03,
   "text": "Yüzyıllar boyunca Karadeniz'den Boğaz'a giren gemiciler, dört yöne dönüp selam verirdi."
  },
  {
   "start": 6.39,
   "end": 10.51,
   "text": "Rivayete göre bu selam, İstanbul Boğazı'nın dört muhafızınaydı."
  },
  {
   "start": 10.87,
   "end": 12.19,
   "text": "Birincisi Üsküdar'da: Aziz Mahmud Hüdâyî."
  },
  {
   "start": 12.55,
   "end": 19.95,
   "text": "Sultan Birinci Ahmed'in hocasıydı; padişahın ona su dökecek kadar hürmet ettiği anlatılır."
  },
  {
   "start": 20.3,
   "end": 21.69,
   "text": "İkincisi karşı kıyıda, Beşiktaş'ta: Yahya Efendi."
  },
  {
   "start": 22.0,
   "end": 30.82,
   "text": "Kanuni Sultan Süleyman'ın süt kardeşiydi; Boğaz'ı gören tepedeki dergâhı bugün hâlâ ziyaret ediliyor."
  },
  {
   "start": 31.18,
   "end": 32.69,
   "text": "Üçüncüsü Rumeli Kavağı'nda: Telli Baba."
  },
  {
   "start": 33.02,
   "end": 37.3,
   "text": "Rivayete göre evlenmek isteyen genç kızlar buraya gelir, gelinliklerinden bir tel bırakırdı."
  },
  {
   "start": 37.55,
   "end": 41.24,
   "text": "Peki dördüncüsü kim? Cevabı sizi şaşırtabilir."
  },
  {
   "start": 41.53,
   "end": 46.49,
   "text": "Beykoz'daki bir tepede on yedi metrelik bir kabir var: Hz. Yuşa'ya ait olduğuna inanılıyor."
  },
  {
   "start": 46.85,
   "end": 53.11,
   "text": "Rivayete göre bu kabrin yerini Yahya Efendi bir rüyada görmüştü."
  },
  {
   "start": 53.47,
   "end": 59.36,
   "text": "Ancak Bağdat'ta da Yuşa'ya ait bir makam bulunuyor, bazı araştırmacılar bu yüzden şüpheyle yaklaşıyor."
  },
  {
   "start": 59.71,
   "end": 64.23,
   "text": "Tepenin hemen yanında ise Boğaz'ın Karadeniz kapısını tutan Yoros Kalesi yükselir."
  },
  {
   "start": 64.57,
   "end": 67.89,
   "text": "Antik çağda burası \"Hieron\" diye bilinen kutsal bir alandı."
  },
  {
   "start": 68.24,
   "end": 73.36,
   "text": "Kale yüzyıllar boyunca el değiştirdi; bir dönem Ceneviz gemileri bu sulardan vergi topladı."
  },
  {
   "start": 73.72,
   "end": 76.17,
   "text": "Bugün dört muhafız hâlâ yerinde duruyor."
  },
  {
   "start": 76.53,
   "end": 79.99,
   "text": "Sen bu dört türbeden hangisini ziyaret ettin? Yorumlara yaz."
  }
 ]
}