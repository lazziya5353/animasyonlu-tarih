 "outro": {
  "start": 119.246958,
  "title": "EN ANLAMLI SEMBOL HANGİSİ?",
  "line": "Yorumlara yaz",
  "line_at": 121.546958
 },
 "duration": 125.45,
 "jumps": [],
 "captions": [
  {
   "start": 0.0,
   "end": 2.4,
   "text": "Bu armada 30'dan fazla sembol var."
  },
  {
   "start": 2.82,
   "end": 4.38,
   "text": "Çoğu insan birini bile bilmiyor."
  },
  {
   "start": 4.82,
   "end": 6.68,
   "text": "Bu, Osmanlı Devleti'nin arması."
  },
  {
   "start": 7.04,
   "end": 11.96,
   "text": "Son şeklini 17 Nisan 1882'de, İkinci Abdülhamid döneminde aldı."
  },
  {
   "start": 12.24,
   "end": 16.0,
   "text": "İlk Batı tarzı Osmanlı arması ise Abdülmecid zamanında hazırlandı."
  },
  {
   "start": 16.32,
   "end": 20.36,
   "text": "Bir de dikkat et: Avrupa armalarında aslan, kartal gibi hayvanlar olur."
  },
  {
   "start": 20.76,
   "end": 27.49,
   "text": "Osmanlı armasında tek bir hayvan bile yok. Bunun, İslam geleneğinde canlı tasvirinden kaçınılmasıyla ilgili olduğu düşünülür."
  },
  {
   "start": 27.52,
   "end": 29.98,
   "text": "En tepede ışınlar saçan bir güneş var."
  },
  {
   "start": 30.36,
   "end": 33.16,
   "text": "Devletin büyüklüğünü ve parlaklığını anlattığı yorumlanır."
  },
  {
   "start": 33.48,
   "end": 37.54,
   "text": "Güneşin tam ortasında padişahın tuğrası duruyor. Yani resmî imzası."
  },
  {
   "start": 37.98,
   "end": 42.88,
   "text": "Padişah değişince armadaki tuğra da değişirdi. Bu çizimdeki, Sultan Reşad'ın tuğrası."
  },
  {
   "start": 43.2,
   "end": 47.82,
   "text": "Tuğranın da kendi parçaları var: yukarı uzanan üç tuğ, soldaki iç içe beyzeler,"
  },
  {
   "start": 48.28,
   "end": 51.63,
   "text": "sağa uzanan kollar ve en altta padişahın adının yazdığı sere."
  },
  {
   "start": 51.66,
   "end": 54.42,
   "text": "Tuğranın altındaki hilalde Arapça bir yazı var."
  },
  {
   "start": 54.78,
   "end": 58.14,
   "text": "Anlamı kabaca: İlahi yardıma dayanan Yüce Osmanlı Devleti."
  },
  {
   "start": 58.42,
   "end": 60.38,
   "text": "Hilalin kendisi de İslam'ın simgesi."
  },
  {
   "start": 60.74,
   "end": 62.58,
   "text": "Kalkanın üstünde sorguçlu bir kavuk var."
  },
  {
   "start": 62.96,
   "end": 67.94,
   "text": "Avrupa armalarındaki tacın yerine, Osman Gazi'ye ve hanedanın köküne gönderme olarak yorumlanır."
  },
  {
   "start": 68.42,
   "end": 70.88,
   "text": "Ortadaki kalkan yıldızlar ve hilallerle çevrili."
  },
  {
   "start": 71.28,
   "end": 74.92,
   "text": "Bazıları bunu imparatorluktaki farklı halkların bir arada oluşu diye yorumlar."
  },
  {
   "start": 75.3,
   "end": 76.82,
   "text": "Solda yeşil sancak hilafeti,"
  },
  {
   "start": 77.18,
   "end": 79.85,
   "text": "sağda kırmızı sancak ise devleti ve saltanatı temsil eder."
  },
  {
   "start": 79.88,
   "end": 82.1,
   "text": "Sol tarafta bir terazi var: adalet."
  },
  {
   "start": 82.48,
   "end": 85.88,
   "text": "Altındaki iki kitaptan biri şeriatı, diğeri kanunları temsil eder."
  },
  {
   "start": 86.36,
   "end": 88.5,
   "text": "Hemen yanındaki çiçek demeti ve bereket boynuzu,"
  },
  {
   "start": 88.82,
   "end": 90.06,
   "text": "barışı ve bolluğu anlatır."
  },
  {
   "start": 90.46,
   "end": 93.76,
   "text": "Boynuzun altındaki küçük çapa ise Osmanlı donanmasının simgesi."
  },
  {
   "start": 94.12,
   "end": 96.22,
   "text": "Sağ tarafta kocaman bir top ve gülleler var."
  },
  {
   "start": 96.54,
   "end": 97.58,
   "text": "Yani ordunun gücü."
  },
  {
   "start": 98.04,
   "end": 101.62,
   "text": "Etrafta kılıçlar, mızraklar, teberler, hatta tabanca ve tüfek var."
  },
  {
   "start": 101.9,
   "end": 105.0,
   "text": "Eski ve yeni silahlar yan yana: hem gelenek hem modernleşme."
  },
  {
   "start": 105.48,
   "end": 107.18,
   "text": "Ortanın altında küçük bir meşale var."
  },
  {
   "start": 107.46,
   "end": 109.41,
   "text": "Eğitimi ve ilerlemeyi simgelediği yorumlanır."
  },
  {
   "start": 109.44,
   "end": 112.3,
   "text": "En altta asılı madalyalar ise Osmanlı nişanları."
  },
  {
   "start": 112.54,
   "end": 116.7,
   "text": "Şefkat, Mecidî, Osmanî ve İmtiyaz gibi. Devlete hizmet edenlere verilirdi."
  },
  {
   "start": 117.24,
   "end": 119.26,
   "text": "Bu arma, saltanatın sonuna kadar kullanıldı."
  },
  {
   "start": 119.68,
   "end": 122.6,
   "text": "Sence bu sembollerin en anlamlısı hangisi? Yorumlara yaz."
  }
 ]
}