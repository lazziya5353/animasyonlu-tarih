 "captions": [
  {
   "start": 2.07,
   "end": 6.6,
   "text": "Söğüt'te küçük bir obanın çadırında, bir cihan devletinin tohumu atıldı."
  },
  {
   "start": 6.73,
   "end": 11.0,
   "text": "Osman Gazi'nin sancağını, Orhan Gazi Bursa'ya dikti."
  },
  {
   "start": 12.61,
   "end": 15.6,
   "text": "Yirmi bir yaşındaki Fatih, gemileri karadan yürüttü."
  },
  {
   "start": 15.6,
   "end": 17.4,
   "text": "İstanbul fethedildi."
  },
  {
   "start": 17.48,
   "end": 21.8,
   "text": "Yavuz Sultan Selim ile Kutsal Emanetler İstanbul'a geldi."
  },
  {
   "start": 21.87,
   "end": 25.95,
   "text": "Kanuni'nin devrinde sancağımız üç kıtada dalgalandı."
  },
  {
   "start": 26.02,
   "end": 30.6,
   "text": "1683'te Viyana önlerinde uzun bir geri çekiliş başladı."
  },
  {
   "start": 30.73,
   "end": 35.0,
   "text": "Ama ecdadımız asırlar boyu, cepheden cepheye koştu."
  },
  {
   "start": 36.68,
   "end": 40.5,
   "text": "Çanakkale'de bir nesil, \"geçilmez\" dedi ve geçit vermedi."
  },
  {
   "start": 40.59,
   "end": 43.9,
   "text": "Savaş bitti. Vatan, işgal altındaydı."
  },
  {
   "start": 43.98,
   "end": 48.15,
   "text": "19 Mayıs 1919'da Samsun'da bir ışık yandı."
  },
  {
   "start": 48.23,
   "end": 52.3,
   "text": "Ankara'da Meclis kuruldu, millet yeniden ayağa kalktı."
  },
  {
   "start": 52.39,
   "end": 54.6,
   "text": "Büyük Taarruz'la zafer kazanıldı."
  },
  {
   "start": 54.73,
   "end": 58.5,
   "text": "Ve 1923'te Cumhuriyet ilan edildi."
  },
  {
   "start": 58.57,
   "end": 62.7,
   "text": "Altı yüz yirmi dört yıllık yürüyüş, yeni bir şafağa ulaştı."
  },
  {
   "start": 62.85,
   "end": 65.6,
   "text": "Bu toprakları bize emanet edenlere rahmetle."
  }
 ],
